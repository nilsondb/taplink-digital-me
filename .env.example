# Authera Link Card — configuração local
APP_URL=http://192.168.100.37:8085
SESSION_DAYS=30

# Esta conta será criada como administradora quando se cadastrar.
# Troque pelo e-mail que você realmente usará antes de subir o serviço.
BOOTSTRAP_ADMIN_EMAIL=admin@authera.ia.br

# Banco/arquivos (o docker-compose já monta /srv/nilson/data/authera-link-card em /app/data)
DATA_DIR=/app/data
DB_FILE=authera-link-card.db

# Recuperação de senha por e-mail (opcional no primeiro teste local)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
