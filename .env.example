# Authera Link Card — configuração JARVIS / produção
APP_URL=https://link.authera.ia.br
SESSION_DAYS=30

# Esta conta será criada como administradora quando se cadastrar.
BOOTSTRAP_ADMIN_EMAIL=admin@authera.ia.br

# Banco/arquivos persistentes
# O docker-compose monta /srv/nilson/data/authera-link-card em /app/data.
DATA_DIR=/app/data
DB_FILE=authera-link-card.db

# Cloudflare Tunnel (produção)
# Crie um Tunnel remoto no Cloudflare e cole aqui apenas o token do túnel.
# Nunca envie este token para o GitHub.
CLOUDFLARE_TUNNEL_TOKEN=

# Recuperação de senha por e-mail
# Pode ficar vazio até configurarmos o SMTP corporativo da Authera.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
